| order by Timestamp asc

DeviceProcessEvents
| where DeviceName =~ "user1"
| where Timestamp between (
    datetime(2026-08-10 13:20:00) ..
    datetime(2026-08-10 14:00:00)
)
| where
    ProcessCommandLine has_any (
        "Invoke-AtomicTest",
        "Invoke-AtomicTestAll",
        "Get-AtomicTest",
        "Test-Atomic",
        "Start-Atomic",
        "Invoke-Atomic",
        "Invoke-AtomicRedTeam"
    )
    or FileName in~ (
        "AdFind.exe",
        "SOAPHound.exe",
        "BadPotato.exe",
        "Syscall.exe",
        "listplanting.exe",
        "injectcontext.exe",
        "injectview.exe"
    )
    or FolderPath contains "\\atomic-red-team\\"
    or FolderPath contains "\\AtomicRedTeam\\"
| project
    Timestamp,
    AccountName,
    FileName,
    FolderPath,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    ProcessId,
    InitiatingProcessId,
    SHA256
| order by Timestamp asc

AlertInfo
| where Timestamp between (
    datetime(2026-08-10 13:20:00) ..
    datetime(2026-08-10 15:00:00)
)
| where Title has_any (
    "PowerSploit",
    "Atomic",
    "Wacatac",
    "post-exploitation",
    "ransomware",
    "lateral movement"
)
| project
    Timestamp,
    AlertId,
    Title,
    Severity,
    Category,
    ServiceSource,
    DetectionSource
| order by Timestamp asc

AlertEvidence
| where Timestamp between (
    datetime(2026-08-10 13:20:00) ..
    datetime(2026-08-10 15:00:00)
)
| where DeviceName =~ "user1"
| project
    Timestamp,
    AlertId,
    EntityType,
    EvidenceRole,
    FileName,
    FolderPath,
    ProcessCommandLine,
    AccountName,
    SHA256,
    RemoteIP
| order by Timestamp asc
