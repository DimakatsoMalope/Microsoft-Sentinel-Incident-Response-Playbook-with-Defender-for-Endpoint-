DeviceInfo
| where DeviceName =~ "DESKTOP-CM2A37C"
| project Timestamp, DeviceName, PublicIP, OSPlatform, LoggedOnUsers
| order by Timestamp desc

DeviceNetworkEvents
| where Timestamp between (datetime(2026-08-10 13:10:00) .. datetime(2026-08-10 13:25:00))
| where RemoteIP == "41.13.114.11"
| project Timestamp, DeviceName, LocalIP, RemoteIP, RemotePort, Protocol, InitiatingProcessFileName, InitiatingProcessCommandLine
| order by Timestamp asc

