DeviceEvents
| where Timestamp between (datetime(2026-08-10 13:15:00) .. datetime(2026-08-10 13:25:00))
| where DeviceName =~ "user1"
| project Timestamp,
          DeviceName,
          ActionType,
          FileName,
          FolderPath,
          ProcessId,
          InitiatingProcessFileName,
          InitiatingProcessId,
          InitiatingProcessCommandLine,
          AccountName,
          RemoteIP,
          RemotePort,
          AdditionalFields
| order by Timestamp asc

DeviceProcessEvents
| where DeviceName == "user1"
| where Timestamp between (datetime(2026-08-10 13:15:00) .. datetime(2026-08-10 13:20:00))
| where FileName =~ "powershell.exe"
| project Timestamp, DeviceName, AccountName, ProcessId, InitiatingProcessFileName, InitiatingProcessCommandLine, ProcessCommandLine
| order by Timestamp asc

DeviceProcessEvents
| where Timestamp between (datetime(2026-08-10 13:15:00) .. datetime(2026-08-10 13:20:00))
