DeviceProcessEvents
| where Timestamp between (datetime(2026-08-10 13:17:00) .. datetime(2026-08-10 13:19:00))
| where FileName =~ "powershell.exe"
| project Timestamp, DeviceName, AccountName, ProcessId, ProcessCommandLine, InitiatingProcessFileName, InitiatingProcessId
| order by Timestamp asc

let DeviceName = "USER1";
let StartTime = datetime(2026-08-10 11:30:00);
let EndTime   = datetime(2026-08-10 12:00:00);

DeviceProcessEvents
| where Timestamp between (datetime(2026-08-10 12:15:00) .. datetime(2026-08-10 17:20:00))
| where DeviceName =~ DeviceName
| where
    ProcessCommandLine has_any (
        "Invoke-AtomicTest",
        "Get-AtomicTest",
        "Test-Atomic",
        "Start-Atomic",
        "AtomicRedTeam",
        "atomic-red-team"
    )
    or FolderPath has_any (
        @"\atomic-red-team\",
        @"\AtomicRedTeam\"
    )
    or FileName in~ (
        "Invoke-DownloadCradle.ps1",
        "AdFind.exe",
        "SOAPHound.exe",
        "BadPotato.exe",
        "Syscall.exe"
    )
| project
    Timestamp,
    FileName,
    FolderPath,
    ProcessCommandLine,
    AccountName,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    SHA256
| order by Timestamp asc


DeviceProcessEvents
| where Timestamp between (datetime(2026-08-10 09:15:00) .. datetime(2026-08-10 10:20:00))
| where DeviceName =~ "USER1"
| project
    Timestamp,
    DeviceName,
    AccountName,
    FileName,
    FolderPath,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    SHA256,
    ProcessId,
